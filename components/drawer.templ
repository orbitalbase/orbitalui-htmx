// Drawer — the generic full-screen bottom-sheet component (drawer.go +
// assets/src/app.css, docs/ui-components.md §3d, docs/ui-drawer-templates.md
// §1). A fixed translucent overlay + a bottom panel that slides up to
// max-height: calc(100% - 10vh) — the 10vh dimmed sliver of page above the
// sheet is the dismiss affordance (backdrop hit-test). The sheet is NOT a
// native <dialog>: role="dialog" aria-modal="true" on the panel, Esc +
// backdrop + × close via assets/orbital-ui.js, mirroring the dialog
// conventions in modal.templ — the Alpine x-data (ouiDrawer) on the overlay
// carries the backdrop hit-test and the Esc keydown (focus lives inside the
// panel, so keydown bubbles up to the overlay). Directives are bare references
// so the markup runs under Alpine's CSP build. Placement: a right slide-over
// from 640px up, a bottom sheet below.
//
//	Params: opts DrawerOpts, children templ.Component (the sheet content —
//	by convention an htmx fragment target, see DrawerContentID).
//
// Usage — the page renders ONE drawer shell per flow (its content region is
// empty in the static page) and loads the drawer's inner form from a
// fragment endpoint. Openers are ordinary buttons carrying the fragment
// wiring + data-open-drawer; the two fire in order (orbital-ui.js opens the sheet,
// htmx fills the content region):
//
//	@components.Button(components.ButtonVariantPrimary, "", components.ButtonOpts{
//		Label: "Add new template",
//		Attrs: templ.Attributes{
//			"hx-get":           "/settings/templates/new",
//			"hx-target":        "#tpl-drawer-content",
//			"hx-swap":          "innerHTML",
//			"data-open-drawer": "tpl-drawer",
//		},
//	})
//	@components.Drawer(components.DrawerOpts{ID: "tpl-drawer", Title: "Edit template"}) {
//		<div id="tpl-drawer-content"></div>
//	}
//
//	The empty #tpl-drawer-content region is the htmx target — DrawerContentID
//	keeps it in lockstep with the drawer id; pages that pre-fill the sheet
//	(rare) pass real children instead.
//
// htmx mechanics (same as dialogs): validation errors come back as 422 with
// the re-rendered fragment (orbital-ui.js swaps 422s) so
// the sheet stays open with inline FieldErrors; success answers an
// HX-Trigger: drawerClose response header — orbital-ui.js closes the open drawer.
//
// Reading surfaces pass DrawerOpts.Fullscreen: the header gains a toggle that
// expands the panel to the whole viewport (orbital-ui.js toggles .drawer-panel--full,
// CSS drops the grab handle and the top rounding) for long content — a log or
// a reasoning trace — without a navigation or a second component.
//
// Multi-document surfaces (a log in which you click through to more records)
// pass DrawerOpts.Tabbed: the header renders an empty, horizontally scrollable
// strip (DrawerTabsID) that the host's tab runtime fills with one tab per record
// (orbital-ui.js only reveals its scroll buttons on overflow). The visible
// title becomes screen-reader-only, because each tab's content carries its own
// heading; the host runtime keeps the hidden h2 in step with the active tab so
// aria-labelledby still names the panel. See docs/ui-components.md §3d.
package components

templ Drawer(opts DrawerOpts, children templ.Component) {
	<div
		id={ opts.ID }
		class="drawer-overlay"
		x-data="ouiDrawer"
		x-on:click="backdrop"
		x-on:keydown.escape="escape"
	>
		<div
			class={ drawerPanelClass(opts) }
			role="dialog"
			aria-modal="true"
			aria-labelledby={ DrawerTitleID(opts.ID) }
			tabindex="-1"
		>
			<header class="drawer-panel__header">
				<div class="drawer-panel__heading">
					if opts.Tabbed {
						<h2 id={ DrawerTitleID(opts.ID) } class="visually-hidden">{ opts.Title }</h2>
					} else {
						<h2 id={ DrawerTitleID(opts.ID) }>{ opts.Title }</h2>
						if opts.Subtitle != "" {
							<p class="drawer-panel__subtitle">{ opts.Subtitle }</p>
						}
					}
				</div>
				if opts.Tabbed {
					<div class="drawer-tabs" data-log-tabs-wrap>
						<button
							type="button"
							class="drawer-tabs__nav drawer-tabs__nav--prev"
							data-log-scroll="-1"
							aria-label="Scroll to earlier open records"
							title="Earlier records"
						>@Icon("chevron-left")
</button>
						<div
							id={ DrawerTabsID(opts.ID) }
							class="drawer-tabs__track"
							role="tablist"
							aria-label={ drawerTabsLabel(opts) }
						></div>
						<button
							type="button"
							class="drawer-tabs__nav drawer-tabs__nav--next"
							data-log-scroll="1"
							aria-label="Scroll to later open records"
							title="Later records"
						>@Icon("chevron-right")
</button>
					</div>
				}
				<div class="drawer-panel__tools">
					if opts.Fullscreen {
						<button
							type="button"
							class="drawer-panel__tool"
							data-drawer-fullscreen
							aria-pressed="false"
							aria-label={ drawerFullscreenLabel(false) }
							title={ drawerFullscreenLabel(false) }
						>
							<span class="drawer-panel__tool-icon drawer-panel__tool-icon--expand" aria-hidden="true">@Icon("expand")
</span>
							<span class="drawer-panel__tool-icon drawer-panel__tool-icon--contract" aria-hidden="true">@Icon("contract")
</span>
						</button>
					}
					<button
						type="button"
						class="drawer-panel__close"
						aria-label={ drawerCloseLabel(opts) }
						data-close-drawer
					>
						@Icon("close")
					</button>
				</div>
			</header>
			<div class="drawer-content" id={ DrawerContentID(opts.ID) }>
				if children != nil {
					@children
				}
			</div>
		</div>
	</div>
}
