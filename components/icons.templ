package components

templ Icon(name string, className string) {
	<svg class={ className } viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		switch name {
			case "spark":
				<path d="m12 3 1.7 5.3L19 10l-5.3 1.7L12 17l-1.7-5.3L5 10l5.3-1.7L12 3Z"></path>
				<path d="m19 16 .8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8L19 16Z"></path>
			case "send":
				<path d="m22 2-7 20-4-9-9-4Z"></path>
				<path d="M22 2 11 13"></path>
			case "paperclip":
				<path d="m21.4 11.1-8.5 8.5a5.5 5.5 0 0 1-7.8-7.8l9.2-9.2a3.7 3.7 0 0 1 5.2 5.2l-9.2 9.2a1.8 1.8 0 0 1-2.6-2.6l8.5-8.5"></path>
			case "pin":
				<path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"></path>
				<circle cx="12" cy="10" r="2.5"></circle>
			case "briefcase":
				<rect x="3" y="7" width="18" height="14" rx="2"></rect>
				<path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 12h18M10 12v2h4v-2"></path>
			case "building":
				<rect x="4" y="3" width="16" height="18" rx="2"></rect>
				<path d="M9 7h1M14 7h1M9 11h1M14 11h1M9 15h1M14 15h1M10 21v-3h4v3"></path>
			case "money":
				<rect x="3" y="5" width="18" height="14" rx="2"></rect>
				<path d="M7 9h.01M17 15h.01M12 9v6M14 10.5c0-.8-.9-1.5-2-1.5s-2 .7-2 1.5 1 1.2 2 1.5 2 .7 2 1.5-.9 1.5-2 1.5-2-.7-2-1.5"></path>
			case "check":
				<path d="m5 12 4 4L19 6"></path>
			case "chevron":
				<path d="m7 10 5 5 5-5"></path>
			case "plus":
				<path d="M12 5v14M5 12h14"></path>
			case "close":
				<path d="m18 6-12 12M6 6l12 12"></path>
			case "info":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M12 11v5M12 8h.01"></path>
			case "clock":
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M12 7v5l3 2"></path>
			case "arrow-right":
				<path d="M5 12h14M13 6l6 6-6 6"></path>
			case "sparkle-small":
				<path d="m12 3 1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3Z"></path>
			case "briefcase-small":
				<rect x="4" y="7" width="16" height="13" rx="2"></rect>
				<path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M4 12h16"></path>
			default:
				<circle cx="12" cy="12" r="9"></circle>
		}
	</svg>
}
