package components

templ ChatThread(id string, label string, className string, children templ.Component) {
	<div id={ id } class={ className } role="log" aria-label={ label } aria-live="polite" aria-relevant="additions text">
		if children != nil {
			@children
		}
	</div>
}

templ SummaryCard(title string, iconName string, className string, fields templ.Component) {
	<article class={ "oui-summary-card " + className } aria-label={ title }>
		<div class="oui-summary-card__head mb-3 flex items-center gap-2">
			<span class="oui-summary-card__icon grid h-6 w-6 place-items-center rounded-lg">@Icon(iconName, "h-3.5 w-3.5")</span>
			{ title }
		</div>
		<dl class="oui-summary-card__fields grid grid-cols-[auto_1fr] gap-x-3 gap-y-2">
			if fields != nil {
				@fields
			}
		</dl>
	</article>
}

templ SummaryField(label string, expression string) {
	<div class="contents">
		<dt class="oui-summary-card__term">{ label }</dt>
		<dd class="oui-summary-card__value min-w-0 truncate" x-text={ expression }></dd>
	</div>
}

// Avatar renders a neutral assistant identity that can be reused in chat surfaces.
templ AssistantAvatar(sizeClass string, iconSize string) {
	<div class={ "oui-assistant-avatar grid shrink-0 place-items-center " + sizeClass } aria-hidden="true">
		@Icon("spark", iconSize)
	</div>
}

templ AssistantMessage(text string) {
	@AssistantMessageContent(assistantMessageText(text))
}

// AssistantMessageContent uses the same message chrome for cited answers and
// other server-rendered content. Hosts own the content and source validation.

templ AssistantMessageContent(content templ.Component) {
	<article class="oui-assistant-message message-enter flex max-w-[38rem] items-start gap-3" aria-label="Assistant message">
		@AssistantAvatar("mt-0.5 h-8 w-8 rounded-xl", "h-4 w-4")
		<div class="oui-assistant-message__body min-w-0 rounded-2xl rounded-tl-md px-4 py-3">
			if content != nil {
				@content
			}
		</div>
	</article>
}

templ assistantMessageText(text string) {
	<p>{ text }</p>
}

templ UserMessage(text string) {
	<article class="oui-user-message-row message-enter flex justify-end" aria-label="User message">
		<div class="oui-user-message max-w-[85%] rounded-2xl rounded-tr-md px-4 py-3"><p>{ text }</p></div>
	</article>
}

templ SuggestionChip(label string, action string) {
	<button type="button" class="oui-suggestion-chip" @click={ action }>{ label }</button>
}

// SuggestionSubmitChip submits a named value through a native form, including
// with JavaScript disabled and under a strict CSP without Alpine expressions.
templ SuggestionSubmitChip(label string, name string, value string) {
	<button type="submit" class="oui-suggestion-chip" name={ name } value={ value }>{ label }</button>
}

templ LoadingSpinner(id string, className string) {
	<svg id={ id } class={ className } viewBox="0 0 24 24" fill="none" aria-hidden="true">
		<circle class="opacity-25" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3"></circle>
		<path class="opacity-90" d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
	</svg>
}
