// DescriptionList, Avatar, ProgressBar, Checklist, Steps and FeedItem — see
// display.go for options.
//
// Usage:
//
//	@components.DescriptionList([]components.DescriptionItem{
//		{Term: "Jurisdiction", Value: "Malaysia"},
//		{Term: "Status", Content: components.StatusBadge("Active", components.ToneSuccess, components.StatusBadgeOpts{})},
//	}, components.DescriptionListOpts{})
//	@components.Avatar("Adri Tan", components.AvatarOpts{Size: components.AvatarSM})
//	@components.ProgressBar(40, components.ProgressOpts{Label: "Profile", ShowValue: true})
package components

import "strconv"

templ DescriptionList(items []DescriptionItem, opts DescriptionListOpts) {
	<dl class={ descriptionListClass(opts) }>
		for _, item := range items {
			<div
				class={ joinClass("ui-dl__row", modifier(item.Wide, "ui-dl__row--wide")) }
			>
				<dt>{ item.Term }</dt>
				<dd
					if item.Field != "" {
						data-field={ item.Field }
					}
				>
					if item.Content != nil {
						@item.Content
					} else if item.Value != "" {
						<span class={ descriptionValueClass(item) }>{ item.Value }</span>
					} else {
						<span class="ui-dl__empty">{ descriptionPlaceholder(opts) }</span>
					}
					if item.Hint != "" {
						<span class="ui-dl__hint">{ item.Hint }</span>
					}
				</dd>
			</div>
		}
	</dl>
}

// DataList is the composable DescriptionList: the same <dl> and layouts,
// with the rows given as DataItem children so values can be rich markup
// (badges, links, avatars, several lines) without building a
// []DescriptionItem. opts.Placeholder is unused; an item renders what it
// is given.
//
//	@components.DataList(components.DescriptionListOpts{Columns: 2}) {
//		@components.DataItem("Role") { Staff engineer }
//		@components.DataItemWide("Status") { @components.Badge(...) }
//	}
templ DataList(opts DescriptionListOpts) {
	<dl class={ descriptionListClass(opts) }>
		{ children... }
	</dl>
}

// DataItem is one label/value row of a DataList; its children are the value.
templ DataItem(label string) {
	@DataItemWith(label, DataItemOpts{}) {
		{ children... }
	}
}

// DataItemWide is a DataItem that spans every column of a multi-column list.
templ DataItemWide(label string) {
	@DataItemWith(label, DataItemOpts{Wide: true}) {
		{ children... }
	}
}

// DataItemWith is DataItem with options: Wide spans every column and Field
// is rendered as data-field on the value element, the hook a host script
// uses to highlight a value an agent just changed.
templ DataItemWith(label string, opts DataItemOpts) {
	<div class={ joinClass("ui-dl__row", modifier(opts.Wide, "ui-dl__row--wide")) }>
		<dt>{ label }</dt>
		<dd
			if opts.Field != "" {
				data-field={ opts.Field }
			}
		>{ children... }</dd>
	</div>
}

templ Avatar(name string, opts AvatarOpts) {
	<span
		class={ avatarClass(name, opts) }
		if avatarLabel(opts) != "" {
			role="img"
			aria-label={ avatarLabel(opts) }
		} else {
			aria-hidden="true"
		}
	>
		if opts.Anonymous {
			<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="12" cy="8.5" r="4.25"></circle><path d="M3.75 21c0-4.07 3.7-6.75 8.25-6.75s8.25 2.68 8.25 6.75z"></path></svg>
		} else if opts.Src != "" {
			<img class="ui-avatar__img" src={ string(opts.Src) } alt="" loading="lazy"/>
		} else {
			<span class="ui-avatar__initials">{ Initials(name) }</span>
		}
		if opts.Status != "" {
			<span class={ "ui-avatar__status ui-avatar__status--" + opts.Status }></span>
		}
	</span>
}

templ ProgressBar(value int, opts ProgressOpts) {
	<div class={ progressClass(opts) }>
		if opts.Label != "" || opts.ShowValue {
			<div class="ui-progress__label">
				if opts.Label != "" {
					<span>{ opts.Label }</span>
				}
				if opts.ShowValue {
					<span class="ui-progress__value">{ strconv.Itoa(clampPercent(value)) }%</span>
				}
			</div>
		}
		<div
			class="ui-progress__track"
			role="progressbar"
			aria-valuemin="0"
			aria-valuemax="100"
			aria-valuenow={ strconv.Itoa(clampPercent(value)) }
			aria-label={ progressName(opts) }
		>
			<span class={ progressFillClass(value) }></span>
		</div>
	</div>
}

templ Checklist(items []ChecklistItem) {
	@ChecklistWith(items, ChecklistOpts{})
}

// ChecklistWith is Checklist with options (Compact variant).
templ ChecklistWith(items []ChecklistItem, opts ChecklistOpts) {
	<ol class={ checklistClass(opts) }>
		for _, item := range items {
			<li class={ joinClass("ui-checklist__item", modifier(item.Done, "ui-checklist__item--done")) }>
				<span class="ui-checklist__mark" aria-hidden="true">
					if item.Done {
						@Icon("check")
					}
				</span>
				<div class="ui-checklist__copy">
					<span class="ui-checklist__title">
						{ item.Title }
						if item.Done {
							<span class="sr-only">(complete)</span>
						}
					</span>
					if item.Description != "" {
						<span class="ui-checklist__description">{ item.Description }</span>
					}
				</div>
				if !item.Done && item.Href != "" {
					<a class="ui-checklist__action" href={ item.Href }>
						if item.ActionLabel != "" {
							{ item.ActionLabel }
						} else {
							Start
						}
						@Icon("arrow-right")
					</a>
				}
			</li>
		}
	</ol>
}

templ Steps(steps []Step) {
	<ol class="ui-steps">
		for i, step := range steps {
			<li
				class={ stepClass(step) }
				if step.State == StepCurrent {
					aria-current="step"
				}
			>
				<span class="ui-steps__marker" aria-hidden="true">
					if step.State == StepDone {
						@Icon("check")
					} else {
						{ strconv.Itoa(i + 1) }
					}
				</span>
				<div class="ui-steps__copy">
					<span class="ui-steps__title">{ step.Title }</span>
					<span class="ui-steps__meta">
						<span class="sr-only">{ stepStateLabel(step.State) }. </span><span>{ step.Meta }</span>
					</span>
					if step.Content != nil {
						<div class="ui-steps__content">
							@step.Content
						</div>
					}
				</div>
			</li>
		}
	</ol>
}

templ FeedItem(opts FeedItemOpts) {
	<li class={ feedItemClass(opts) }>
		if opts.Icon != "" {
			<span class={ feedIconClass(opts) } aria-hidden="true">
				@Icon(opts.Icon)
			</span>
		}
		<div class="ui-feed__copy">
			<div class="ui-feed__head">
				if opts.Href != "" {
					<a class="ui-feed__title" href={ opts.Href }>{ opts.Title }</a>
				} else {
					<span class="ui-feed__title">{ opts.Title }</span>
				}
				if opts.Unread {
					<span class="ui-feed__dot" title="Unread"><span class="sr-only">Unread</span></span>
				}
				if opts.Time != "" {
					<span class="ui-feed__time">{ opts.Time }</span>
				}
			</div>
			if opts.Body != "" {
				<p class="ui-feed__body">{ opts.Body }</p>
			}
			if opts.Actions != nil {
				<div class="ui-feed__actions">
					@opts.Actions
				</div>
			}
		</div>
	</li>
}

// Feed wraps FeedItem rows in the list element they require.
templ Feed(items templ.Component) {
	<ul class="ui-feed">
		if items != nil {
			@items
		}
	</ul>
}
