// Button — the app's single button primitive (ui/Button + .ui-button in v2,
// docs/ui-v1-plan.md §6). Renders a <button type="button|submit"> or an
// <a href> when opts.Href is set (link-buttons for GET navigations).
//
//	Params: variant ButtonVariant (default secondary), size ButtonSize
//	("", ButtonSizeSM or ButtonSizeLG), opts ButtonOpts (see button.go).
//
// Usage:
//
//	@components.Button(components.ButtonVariantPrimary, "", components.ButtonOpts{
//		Icon: "plus", Label: "New entry", Href: templ.SafeURL("/journal/new"),
//	})
//	@components.Button(components.ButtonVariantDanger, components.ButtonSizeSM,
//		components.ButtonOpts{Label: "Void entry", Type: "submit", Form: "f-void"},
//	)
//	@components.Button(components.ButtonVariantAI, "", components.ButtonOpts{Icon: "spark", Label: "Ask the assistant"})
//	@components.Button(components.ButtonVariantQuiet, "", components.ButtonOpts{Icon: "close", IconOnly: true, Label: "Dismiss"})
//	@components.Button(components.ButtonVariantPrimary, components.ButtonSizeLG, components.ButtonOpts{Label: "Continue", Icon: "arrow-right", IconRight: true, Block: true})
//
// Buttons inside htmx partial flows pass their hx attributes through opts
// (HXGet/HXPost/HXTarget/HXSwap/HXTrigger/HXIndicator); server-side
// validation flows keep Type "submit" inside their <form>. Modal triggers set
// Attrs: templ.Attributes{"data-open-dialog": "dlg-id"} (modal.templ).
package components

templ Button(variant ButtonVariant, size ButtonSize, opts ButtonOpts) {
	if opts.Href != "" {
		<a
			href={ opts.Href }
			class={ mergeClass(buttonClass(variant, size, opts), opts.Attrs) }
			if buttonAriaLabel(opts) != "" {
				aria-label={ buttonAriaLabel(opts) }
				title={ buttonAriaLabel(opts) }
			}
			if opts.Target != "" {
				target={ opts.Target }
			}
			if opts.HXGet != "" {
				hx-get={ opts.HXGet }
			}
			if opts.HXPost != "" {
				hx-post={ opts.HXPost }
			}
			if opts.HXTarget != "" {
				hx-target={ opts.HXTarget }
			}
			if opts.HXSwap != "" {
				hx-swap={ opts.HXSwap }
			}
			if opts.HXTrigger != "" {
				hx-trigger={ opts.HXTrigger }
			}
			if opts.HXIndicator != "" {
				hx-indicator={ opts.HXIndicator }
			}
			{ attrsWithoutClass(opts.Attrs)... }
		>
			if opts.Icon != "" && !opts.IconRight {
				@Icon(opts.Icon)
			}
			if buttonShowsLabel(opts) {
				<span>{ opts.Label }</span>
			}
			@buttonTrailingIcon(opts)
		</a>
	} else {
		<button
			type={ buttonType(opts.Type) }
			class={ mergeClass(buttonClass(variant, size, opts), opts.Attrs) }
			if buttonAriaLabel(opts) != "" {
				aria-label={ buttonAriaLabel(opts) }
				title={ buttonAriaLabel(opts) }
			}
			disabled?={ opts.Disabled || opts.Loading }
			if opts.Loading {
				aria-busy="true"
			}
			if opts.Name != "" {
				name={ opts.Name }
			}
			if opts.Value != "" {
				value={ opts.Value }
			}
			if opts.Form != "" {
				form={ opts.Form }
			}
			if opts.HXGet != "" {
				hx-get={ opts.HXGet }
			}
			if opts.HXPost != "" {
				hx-post={ opts.HXPost }
			}
			if opts.HXDelete != "" {
				hx-delete={ opts.HXDelete }
			}
			if opts.HXTarget != "" {
				hx-target={ opts.HXTarget }
			}
			if opts.HXSwap != "" {
				hx-swap={ opts.HXSwap }
			}
			if opts.HXTrigger != "" {
				hx-trigger={ opts.HXTrigger }
			}
			if opts.HXIndicator != "" {
				hx-indicator={ opts.HXIndicator }
			}
			{ attrsWithoutClass(opts.Attrs)... }
		>
			if opts.Loading {
				<span class="ui-button__progress" aria-hidden="true"></span>
			}
			if opts.Icon != "" && !opts.IconRight {
				@Icon(opts.Icon)
			}
			if buttonShowsLabel(opts) {
				<span>{ opts.Label }</span>
			}
			@buttonTrailingIcon(opts)
		</button>
	}
}
