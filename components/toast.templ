package components

// ToastRegion is the fixed notification stack. Render it once per page (in
// AppShellOpts.Overlays). Children are server-rendered Toasts shown on first
// paint. It also carries the templates the runtime clones for raised toasts.
templ ToastRegion() {
	<div class="ui-toasts" role="region" aria-label="Notifications">
		<div class="ui-toasts__stack" data-toast-stack aria-live="polite" aria-atomic="false">
			{ children... }
		</div>
		<template data-toast-template>
			<div class="ui-toast" role="status">
				<span class="ui-toast__icon" data-toast-icon aria-hidden="true"></span>
				<div class="ui-toast__text">
					<p class="ui-toast__title" data-toast-title></p>
					<p class="ui-toast__msg" data-toast-message></p>
				</div>
				<button type="button" class="ui-toast__close" aria-label="Dismiss" data-toast-close>
					@Icon("close")
				</button>
			</div>
		</template>
		for _, tone := range toastTones {
			<template data-toast-icon-for={ tone.Modifier() }>
				@Icon(toastIcon(tone))
			</template>
		}
	</div>
}

// Toast renders one toast inside ToastRegion's stack.
templ Toast(opts ToastOpts) {
	<div
		class={ toastClass(opts) }
		role={ toastRole(opts) }
		if opts.Auto {
			data-toast-auto
		}
	>
		<span class="ui-toast__icon" aria-hidden="true">
			@Icon(toastIcon(opts.Tone))
		</span>
		<div class="ui-toast__text">
			if opts.Title != "" {
				<p class="ui-toast__title">{ opts.Title }</p>
			}
			<p class="ui-toast__msg">{ opts.Message }</p>
		</div>
		<button type="button" class="ui-toast__close" aria-label="Dismiss" data-toast-close>
			@Icon("close")
		</button>
	</div>
}
