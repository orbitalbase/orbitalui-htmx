// EntityPicker — the v2 EntityPicker combobox ported to Alpine (docs/
// ui-v1-plan.md §3/§6): type-ahead over a per-domain JSON endpoint; the
// chosen record's id lands in a hidden <input name={opts.Name}>, so the
// enclosing <form> submits the id while the text field stays human-facing.
// Keyboard model (↑/↓/Enter/Esc/Tab), debounced fetch, fixed dropdown with
// flip-up and the aria combobox/listbox wiring are implemented once in
// assets/orbital-ui.js (the ouiPicker factory) — this templ only mounts the
// config as a data-oui-picker JSON attribute. Every directive is a bare
// property or method reference, so the markup runs under Alpine's CSP build. See docs/ui-components.md §3b for the endpoint wire contract and
// the per-phase registration pattern.
//
// With opts.Create the picker grows a synthetic last row (orbital-ui.js
// createOption()) and Enter POSTs a new record — a row activation (`pick`)
// goes through choose(item), the one place that routes to either a pick or a
// create, so there is no second click path to keep in sync.
//
//	Params: opts EntityPickerOpts.
//
// Usage (account pick on a journal line; endpoint registered by the
// accounts phase):
//
//	@components.EntityPicker(components.EntityPickerOpts{
//		ID: "line-0-account", Label: "Account", Name: "account_id",
//		Endpoint: templ.SafeURL("/api/accounts?book=ACME"), Required: true,
//		Value: f.Lines[0].AccountID, ValueLabel: f.Lines[0].AccountLabel,
//	})
package components

// pickerCreates reports whether the picker actually mints records. Both the Go
// guard in pickerConfigJSON and the runtime key off this, not off a non-nil
// pointer: a Create with no Endpoint would otherwise arm the row while the
// JSON dropped it, so Enter would activate a row whose POST goes nowhere.
func pickerCreates(o EntityPickerOpts) bool {
	return o.Create != nil && o.Create.Endpoint != ""
}

templ EntityPicker(opts EntityPickerOpts) {
	<div class={ pickerClass(opts) } x-data="ouiPicker" data-oui-picker={ pickerConfigJSON(opts) }>
		<input
			type="hidden"
			x-ref="hidden"
			x-bind:value="picked"
			if opts.Name != "" {
				name={ opts.Name }
			}
		/>
		if opts.LabelName != "" {
			// A form that stores the label itself (the bank import wizard records
			// the statement's account NUMBER) posts the displayed label here,
			// read from the same state the input shows.
			<input type="hidden" name={ opts.LabelName } x-bind:value="display"/>
		}
		<label class="visually-hidden" for={ opts.ID }>{ opts.Label }</label>
		<div class="entity-picker__field">
			<input
				class="field-control entity-picker__input"
				type="text"
				x-ref="input"
				id={ opts.ID }
				role="combobox"
				aria-expanded="false"
				aria-controls={ pickerListID(opts.ID) }
				x-bind:aria-expanded="expanded"
				x-bind:aria-activedescendant="activeDescendant"
				aria-autocomplete="list"
				autocomplete="off"
				placeholder={ pickerPlaceholder(opts) }
				value={ opts.ValueLabel }
				x-bind:value="query"
				x-on:input="onInput"
				x-on:keydown="onKey"
				x-on:focus="ensureOpen"
				x-on:blur="onBlur"
			/>
			if opts.AllowClear {
				<button
					type="button"
					class="entity-picker__clear"
					aria-label="Clear selection"
					x-show="showClear"
					x-on:mousedown.prevent="clearPicked"
					x-cloak
				>
					@Icon("close")
				</button>
			}
			<span class="entity-picker__caret" aria-hidden="true"></span>
		</div>
		<ul
			class="entity-picker__list"
			x-ref="list"
			x-show="open"
			x-cloak
			x-on:mousedown.prevent
			x-bind:id="cfg.listId"
			role="listbox"
			x-bind:aria-label="listLabel"
		>
			<template x-for="item in rows" :key="item.id">
				<li
					x-bind:id="item.domId"
					role="option"
					x-bind:aria-selected="item.selected"
					x-bind:class="item.cls"
				>
					<button
						type="button"
						tabindex="-1"
						x-bind:class="item.btnCls"
						x-bind:data-index="item.index"
						x-on:mousedown.prevent="pick"
						x-on:mouseenter="hover"
					>
						<span class="entity-picker__label" x-text="item.label"></span>
						<span class="entity-picker__sublabel" x-show="item.sublabel" x-text="item.sublabel"></span>
					</button>
				</li>
			</template>
			if pickerCreates(opts) {
				<li class="entity-picker__state" x-show="creating" x-cloak>
					<span class="ui-button__progress" aria-hidden="true"></span>Creating…
				</li>
				<li class="entity-picker__state entity-picker__state--error" x-show="createFailed" x-cloak role="alert">
					Couldn't create — check the name and try again.
				</li>
			}
			<li class="entity-picker__state" x-show="busy" x-cloak>
				<span class="ui-button__progress" aria-hidden="true"></span>Loading…
			</li>
			<li class="entity-picker__state entity-picker__state--error" x-show="failed" x-cloak role="alert">
				Couldn't load options — try again.
			</li>
			<li class="entity-picker__state" x-show="showEmpty" x-cloak>
				No matches
			</li>
		</ul>
	</div>
}
