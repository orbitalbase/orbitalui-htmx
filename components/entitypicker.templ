// EntityPicker — the v2 EntityPicker combobox ported to Alpine (docs/
// ui-v1-plan.md §3/§6): type-ahead over a per-domain JSON endpoint; the
// chosen record's id lands in a hidden <input name={opts.Name}>, so the
// enclosing <form> submits the id while the text field stays human-facing.
// Keyboard model (↑/↓/Enter/Esc/Tab), debounced fetch, fixed dropdown with
// flip-up and the aria combobox/listbox wiring are implemented once in
// assets/static/app.js (window.LedgerUI.picker) — this templ only mounts the
// config. See docs/ui-components.md §3b for the endpoint wire contract and
// the per-phase registration pattern.
//
// With opts.Create the picker grows a synthetic last row (app.js
// createOption()) and Enter POSTs a new record — the mousedown target here
// stays `choose(item)`: that method is already the one place that routes an
// activation to either a pick or a create (it keys off the row's `create`
// flag), so there is no second click path to keep in sync.
//
//	Params: opts EntityPickerOpts.
//
// Usage (account pick on a journal line; endpoint registered by the
// accounts phase):
//
//	@components.EntityPicker(components.EntityPickerOpts{
//		ID: "line-0-account", Label: "Account", Name: "account_id",
//		Endpoint: templ.SafeURL("/api/accounts?book=ACME"), Required: true,
//		Value: f.Lines[0].AccountID, ValueLabel: f.Lines[0].AccountLabel,
//	})
package components

// pickerRowKeyExpr is the x-for :key. Keys must be unique across the
// pickerCreates reports whether the picker actually mints records. Both the Go
// guard in pickerDataExpr and the markup key off this, not off a non-nil
// pointer: a Create with no Endpoint would otherwise arm the row here while the
// JSON dropped it, so Enter would activate a row whose POST goes nowhere. One
// predicate, so config and markup cannot disagree.
func pickerCreates(o EntityPickerOpts) bool {
	return o.Create != nil && o.Create.Endpoint != ""
}

// pickerEmptyExpr is the "No matches" gate. An opted-in picker must NOT show it
// while a create row is on screen — the row is the answer to "no matches", and
// an empty-state stacked above an actionable option reads as a dead end. It
// also keeps the string identical for non-create pickers.
func pickerEmptyExpr(o EntityPickerOpts) string {
	if !pickerCreates(o) {
		return "!busy && !failed && open && items.length === 0"
	}
	return "!busy && !failed && !creating && open && options().length === 0"
}

// pickerOptionsExpr picks the iterable the option list renders from. The
// nil-Create form is literally `items`, the pre-create expression: it keeps
// the ~15 existing call sites' rendered markup — and therefore any test or
// stylesheet keyed to it — untouched. An opted-in picker renders options(),
// items plus the synthetic create row, so idx/optId/aria-activedescendant keep
// ONE index space (a row that is visible but unreachable by the keyboard is an
// a11y bug, not a shortcut).
func pickerOptionsExpr(o EntityPickerOpts) string {
	if !pickerCreates(o) {
		return "items"
	}
	return "options()"
}

templ EntityPicker(opts EntityPickerOpts) {
	<div class={ pickerClass(opts) } x-data={ pickerDataExpr(opts) }>
		<input
			type="hidden"
			x-ref="hidden"
			x-model="picked"
			if opts.Name != "" {
				name={ opts.Name }
			}
		/>
		if opts.LabelName != "" {
			// A form that stores the label itself (the bank import wizard records
			// the statement's account NUMBER) posts the displayed label here,
			// read from the same state the input shows. x-model keeps it in step
			// with choose()/clearPicked() without a second source of truth.
			<input type="hidden" name={ opts.LabelName } x-model="display"/>
		}
		<label class="visually-hidden" for={ opts.ID }>{ opts.Label }</label>
		<div class="entity-picker__field">
			<input
				class="field-control entity-picker__input"
				type="text"
				x-ref="input"
				id={ opts.ID }
				role="combobox"
				aria-expanded="false"
				aria-controls={ pickerListID(opts.ID) }
				x-bind:aria-expanded="open ? 'true' : 'false'"
				x-bind:aria-activedescendant="activeId()"
				aria-autocomplete="list"
				autocomplete="off"
				placeholder={ pickerPlaceholder(opts) }
				x-model="query"
				x-on:input="typing()"
				x-on:keydown="onKey($event)"
				x-on:focus="ensureOpen()"
				x-on:blur="onBlur()"
			/>
			if opts.AllowClear {
				<button
					type="button"
					class="entity-picker__clear"
					aria-label="Clear selection"
					x-show="picked && !open"
					x-on:mousedown.prevent="clearPicked()"
					x-cloak
				>
					@Icon("close")
				</button>
			}
			<span class="entity-picker__caret" aria-hidden="true"></span>
		</div>
		<ul
			class="entity-picker__list"
			x-ref="list"
			x-show="open"
			x-cloak
			x-on:mousedown.prevent
			x-bind:id="cfg.listId"
			role="listbox"
			x-bind:aria-label="cfg.label"
		>
			<template x-for={ "(item, i) in " + pickerOptionsExpr(opts) } :key="item.id">
				<li
					x-bind:id="optId(i)"
					role="option"
					x-bind:aria-selected="picked === item.id"
					x-bind:class="i === idx ? 'entity-picker__option entity-picker__option--active' : 'entity-picker__option'"
				>
					<button
						type="button"
						tabindex="-1"
						if pickerCreates(opts) {
							x-bind:class="item.create ? 'entity-picker__option-btn--create-row' : ''"
						}
						x-on:mousedown.prevent="choose(item)"
						x-on:mouseenter="idx = i"
					>
						<span class="entity-picker__label" x-text="item.label"></span>
						<span class="entity-picker__sublabel" x-show="item.sublabel" x-text="item.sublabel"></span>
					</button>
				</li>
			</template>
			if pickerCreates(opts) {
				<li class="entity-picker__state" x-show="creating" x-cloak>
					<span class="ui-button__progress" aria-hidden="true"></span>Creating…
				</li>
				<li class="entity-picker__state entity-picker__state--error" x-show="createFailed" x-cloak role="alert">
					Couldn't create — check the name and try again.
				</li>
			}
			<li class="entity-picker__state" x-show="busy" x-cloak>
				<span class="ui-button__progress" aria-hidden="true"></span>Loading…
			</li>
			<li class="entity-picker__state entity-picker__state--error" x-show="failed" x-cloak role="alert">
				Couldn't load options — try again.
			</li>
			<li class="entity-picker__state" x-show={ pickerEmptyExpr(opts) } x-cloak>
				No matches
			</li>
		</ul>
	</div>
}
