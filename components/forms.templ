package components

// HTMXPostForm wraps child components in a POST form with standard HTMX targeting.
templ HTMXPostForm(id string, action string, target string, swap string, indicator string, className string, children templ.Component) {
	<form id={ id } method="post" action={ action } class={ className } hx-post={ templ.URL(action) } hx-target={ target } hx-swap={ swap }
		if indicator != "" {
			hx-indicator={ indicator }
		}
	>
		@children
	</form>
}
