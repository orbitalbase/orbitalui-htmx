// Disclosure — a native <details> expander for secondary content ("Posting
// details", "Audit trail", "Advanced" in forms, an inline editor, a danger
// zone). Works with zero JavaScript: open state is native, which is what lets
// progressive disclosure survive a strict script-src 'self' policy
// (docs/ui-v1-plan.md §6).
//
//	Params: label string (summary text), opts DisclosureOpts, children — the
//	revealed content.
//
// Usage:
//
// Disclosure takes its body as an argument; DisclosureBlock (disclosure.go)
// takes it from a templ children block instead:
//
//	@components.DisclosureBlock("Audit trail", components.DisclosureOpts{Summary: "created 3 Sep 2026"}) {
//		Entry #42 · posted by …
//	}
//	@components.DisclosureBlock("Edit service information", components.DisclosureOpts{
//		Variant: components.DisclosurePanel, Hint: "4 fields",
//	}) { … }
//	@components.DisclosureBlock("Delete this package", components.DisclosureOpts{
//		Variant: components.DisclosureDanger,
//	}) { … }
package components

templ Disclosure(label string, opts DisclosureOpts, children templ.Component) {
	<details
		class={ mergeClass(disclosureClass(opts), opts.Attrs) }
		open?={ opts.Open }
		if opts.ID != "" {
			id={ opts.ID }
		}
		if opts.Name != "" {
			name={ opts.Name }
		}
		{ attrsWithoutClass(opts.Attrs)... }
	>
		<summary
			if opts.SummaryID != "" {
				id={ opts.SummaryID }
			}
		>
			<span class="disclosure__chevron" aria-hidden="true">
				@Icon("chevron-right")
			</span>
			<span class="disclosure__label">{ label }</span>
			if opts.Hint != "" {
				<span class="disclosure__hint">{ opts.Hint }</span>
			} else if opts.Summary != "" && !opts.Open {
				<span class="disclosure__hint">{ opts.Summary }</span>
			}
		</summary>
		<div class={ joinClass("disclosure__body", opts.BodyClass) }>
			if children != nil {
				@children
			}
		</div>
	</details>
}
