// StatusBadge — the v2 StatusBadge dot-pill ported to server HTML: a small
// .ui-status chip with an optional leading dot and a text label in a tone.
// Tones are never used alone — the label always carries the meaning
// (docs/ui-v1-plan.md §4/§6).
//
//	Params: label string, tone Tone, opts StatusBadgeOpts.
//	Dot: nil/true shows the leading mark; Subtle renders the quiet neutral
//	chip (no tint) for meta labels (sources, "Current", …) where colour
//	would be noise.
//
// Usage (domain packages map their enum → label + tone in one place):
//
//	@components.StatusBadge("Draft", components.ToneInfo, components.StatusBadgeOpts{})
//	@components.StatusBadge("Posted", components.ToneSuccess, components.StatusBadgeOpts{})
package components

// StatusBadgeOpts tweaks the chip: Dot nil/true = show the leading mark,
// Subtle = drop the tinted tone and render the quiet neutral chip.
type StatusBadgeOpts struct {
	Dot    *bool // nil or true → leading mark; false → text-only chip
	Subtle bool
	Class  string // extra classes
}

// showBadgeDot resolves the dot default (true unless explicitly false).
func showBadgeDot(o StatusBadgeOpts) bool {
	return o.Dot == nil || *o.Dot
}

// badgeClass assembles the chip classes: base + tone modifier (unless
// subtle) + extras.
func badgeClass(t Tone, o StatusBadgeOpts) string {
	c := "ui-status"
	if !o.Subtle {
		c += " " + t.StatusClass()
	}
	if o.Class != "" {
		c += " " + o.Class
	}
	return c
}

// BadgeOpts tweaks a Badge.
//
//	Dot — show a leading dot in the tone colour.
//	Hollow — show the leading dot as a ring (a pending or not-yet state); it
//	    implies Dot.
//	Muted — drop the tone tint for a quiet neutral label.
//	Mono — set the label in the numeric face (codes, ids, counts).
//	Icon — icon-set name drawn before the label.
type BadgeOpts struct {
	Dot    bool
	Hollow bool
	Muted  bool
	Mono   bool
	Icon   string
	Class  string
}

// badgeBoxClass assembles the Badge classes: base, tone modifier (unless
// muted) and the option modifiers.
func badgeBoxClass(t Tone, o BadgeOpts) string {
	tone := ""
	if !o.Muted && t.Modifier() != string(ToneNeutral) {
		tone = "ui-badge--" + t.Modifier()
	}
	return joinClass("ui-badge", tone, modifier(o.Muted, "ui-badge--muted"), modifier(o.Mono, "ui-badge--mono"), modifier(o.Hollow, "ui-badge--hollow"), o.Class)
}

// Badge is the generic label chip: a small rounded rectangle in a tone
// (neutral, brand, accent, info, success, warning, danger or ai). Where
// StatusBadge is the pill for a record's state, Badge labels what a thing is
// (a plan, a side, a kind, a count). The label always carries the meaning;
// the tone only supports it.
//
//	@components.Badge(components.ToneBrand, "Talent", components.BadgeOpts{Dot: true})
//	@components.Badge(components.ToneNeutral, "INV-0042", components.BadgeOpts{Mono: true})
templ Badge(tone Tone, label string, opts BadgeOpts) {
	<span class={ badgeBoxClass(tone, opts) }>
		if opts.Dot || opts.Hollow {
			<span class="ui-badge__dot" aria-hidden="true"></span>
		}
		if opts.Icon != "" {
			@Icon(opts.Icon)
		}
		{ label }
	</span>
}

templ StatusBadge(label string, tone Tone, opts StatusBadgeOpts) {
	<span class={ badgeClass(tone, opts) }>
		if showBadgeDot(opts) {
			<span class="ui-status__mark" aria-hidden="true"></span>
		}
		{ label }
	</span>
}
