// The Icon component: a 24×24 stroke SVG (1.5px, round caps, currentColor,
// no fill) rendering one named path from icons.go — the v2 Icon semantics.
// Callers size it with CSS classes on the svg (width/height attributes give a
// sensible default); tone always comes from the surrounding text color.
package components

// templ Icon renders the named icon. class is optional extra CSS classes
// (e.g. "w-4 h-4"); the svg keeps stroke=currentColor / fill=none so it
// inherits text color.
templ Icon(name string, class ...string) {
	<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class={ iconClass(class...) }>
		<path d={ Path(name) }></path>
	</svg>
}

// IconSized renders Icon at an explicit pixel size: 12, 14, 16, 20 or 24
// (the other values keep Icon's default). The size is a class, ui-icon--16
// and so on, that wins over a container's default svg size.
templ IconSized(name string, px int, class ...string) {
	@Icon(name, iconSizedClass(px, class)...)
}
